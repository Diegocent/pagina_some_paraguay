# Copiar a `.env` y completar valores reales.

VITE_EMAILJS_SERVICE_ID=tu_service_id
VITE_EMAILJS_TEMPLATE_ID_ORDER=tu_template_pedidos
VITE_EMAILJS_PUBLIC_KEY=tu_public_key

# Correo del local (dueño). Configurá la plantilla EmailJS con To = {{to_email_list}} (ver src/services/order.ts).
VITE_EMAILJS_OWNER_EMAIL=hola@mitienda.com

# Opcional: URL absoluta del logo si no usás `public/logo-some-paraguay.png`.
# VITE_SITE_LOGO_URL=https://...
